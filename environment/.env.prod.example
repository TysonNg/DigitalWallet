# Copy to .env.prod on the VPS. Fill values there; never commit real credentials.
IMAGE_PREFIX=ghcr.io/tysonng/digitalwallet
IMAGE_TAG=sha-REPLACE_WITH_40_CHARACTER_COMMIT_SHA
DOMAIN=wallet.example.com
POSTGRES_DB=digital_wallet
POSTGRES_USER=wallet_app
POSTGRES_PASSWORD=
TOKEN_SECRET=
SESSION_SECRET=
ACCESS_TOKEN_EXPIRATION=900000
REFRESH_TOKEN_EXPIRATION=604800000
MAIL_USERNAME=
MAIL_PASSWORD=
MINIO_ROOT_USER=wallet_storage_admin
MINIO_ROOT_PASSWORD=
MEDIA_S3_BUCKET=digital-wallet-media
MEDIA_S3_ACCESS_KEY=wallet_media_app
MEDIA_S3_SECRET_KEY=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Optional sandbox integrations. Use test credentials only for a portfolio demo.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
